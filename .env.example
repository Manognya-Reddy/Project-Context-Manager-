# Copy this file to backend/.env and adjust as needed.

# --- Database ---
PCM_DB_PATH=pcm.db

# --- Embeddings ---
PCM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Optional LLM intent classification. Not required - PCM has a full
#     deterministic fallback that runs when this is off or the call fails.
#     When on, this is tried FIRST for every chat message; only falls back
#     to keyword matching if disabled, no key set, or the API call fails. ---
PCM_LLM_ENABLED=false
PCM_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
PCM_LLM_MODEL=claude-3-5-haiku-latest
GROK_API_KEY=
PCM_GROK_MODEL=grok-beta

# --- Ablation / signal toggles (spec section 25) ---
PCM_SIGNAL_SEMANTIC=true
PCM_SIGNAL_GIT=true
PCM_SIGNAL_FILES=true
PCM_SIGNAL_BROWSER=true
PCM_SIGNAL_TERMINAL=true
PCM_SIGNAL_RECENT_ACTIVITY=true

# --- Hybrid ranking weights (spec section 13) ---
PCM_WEIGHT_SEMANTIC=0.3
PCM_WEIGHT_PATH=0.3
PCM_WEIGHT_GIT=0.2
PCM_WEIGHT_RECENT=0.2

# --- Snapshot checkpoint interval (seconds) ---
PCM_SNAPSHOT_INTERVAL=1800

# --- Access control. Leave blank to disable. Once set (via "set pin 1234"
#     in chat, or here), PCM asks for this PIN before showing saved
#     projects, files, git status, or history. Saving is never gated. ---
PCM_ACCESS_PIN=

# --- Optional: Google Fact Check Tools API for the Chrome tab misinfo
#     warning. Free tier, get a key from Google Cloud Console (enable the
#     "Fact Check Tools API"). Without this, PCM still checks tab domains
#     against a small static list of known low-credibility sites. ---
GOOGLE_FACTCHECK_API_KEY=
